<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-bold text-gray-200">All Bots</h1>
  <%= link_to "New Bot", new_bot_path, class: "bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-4 py-2 rounded-lg" %>
</div>

<% if @bots.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @bots.each do |bot| %>
      <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
        <div class="flex items-start justify-between">
          <%= link_to bot.name, bot_path(bot), class: "text-lg font-bold text-amber-400 hover:text-amber-300" %>
          <span class="text-xs text-gray-500"><%= bot.record %></span>
        </div>
        <p class="text-gray-400 text-sm mt-1"><%= bot.description.present? ? truncate(bot.description, length: 100) : "No description" %></p>
        <div class="flex items-center justify-between mt-3">
          <span class="text-xs text-gray-500">by <%= bot.author_name.present? ? bot.author_name : "Anonymous" %></span>
          <div class="flex gap-2">
            <%= link_to "Edit", edit_bot_path(bot), class: "text-xs text-gray-400 hover:text-white" %>
            <%= link_to "Test", bot_path(bot), class: "text-xs text-amber-400 hover:text-amber-300" %>
          </div>
        </div>
        <div class="flex gap-1 mt-2 flex-wrap">
          <% if bot.config && bot.config["quirks"] %>
            <% bot.config["quirks"].select { |_, v| v }.each do |quirk, _| %>
              <span class="bg-gray-700 text-amber-300 text-xs px-2 py-0.5 rounded-full"><%= quirk.underscore.humanize %></span>
            <% end %>
          <% end %>
          <% if bot.config && bot.config["triggers"]&.any? %>
            <span class="bg-gray-700 text-blue-300 text-xs px-2 py-0.5 rounded-full"><%= bot.config["triggers"].length %> triggers</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12 text-gray-500">
    <p class="text-lg mb-4">No bots yet.</p>
    <%= link_to "Create your first bot", new_bot_path, class: "text-amber-400 hover:text-amber-300" %>
  </div>
<% end %>
