<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="text-3xl font-bold text-amber-400"><%= @bot.name %></h1>
    <p class="text-gray-400 mt-1"><%= @bot.description %></p>
    <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
      <span>by <%= @bot.author_name.present? ? @bot.author_name : "Anonymous" %></span>
      <span><%= @bot.record %></span>
    </div>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_bot_path(@bot), class: "bg-gray-700 hover:bg-gray-600 text-gray-300 px-4 py-2 rounded text-sm" %>
    <%= link_to "Delete", bot_path(@bot), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "bg-red-900 hover:bg-red-800 text-red-300 px-4 py-2 rounded text-sm" %>
  </div>
</div>

<!-- Config Summary -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
    <h3 class="text-sm font-medium text-gray-400 mb-2">Weights</h3>
    <% (@bot.config&.dig("weights") || {}).each do |key, val| %>
      <div class="flex justify-between text-sm mb-1">
        <span class="text-gray-300"><%= key.underscore.humanize %></span>
        <span class="text-amber-400 font-mono"><%= val %></span>
      </div>
    <% end %>
    <div class="border-t border-gray-700 mt-2 pt-2 flex justify-between text-sm">
      <span class="text-gray-300">Randomness</span>
      <span class="text-amber-400 font-mono"><%= @bot.config&.dig("randomness") || 15 %></span>
    </div>
  </div>

  <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
    <h3 class="text-sm font-medium text-gray-400 mb-2">Piece Values</h3>
    <% (@bot.config&.dig("pieceValues") || {}).each do |piece, val| %>
      <div class="flex justify-between text-sm mb-1">
        <span class="text-gray-300"><%= piece %></span>
        <span class="text-amber-400 font-mono"><%= val %></span>
      </div>
    <% end %>
  </div>

  <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
    <h3 class="text-sm font-medium text-gray-400 mb-2">Quirks</h3>
    <% active_quirks = (@bot.config&.dig("quirks") || {}).select { |_, v| v } %>
    <% if active_quirks.any? %>
      <div class="flex flex-wrap gap-1">
        <% active_quirks.each do |quirk, _| %>
          <span class="bg-amber-900/50 text-amber-300 text-xs px-2 py-1 rounded-full"><%= quirk.underscore.humanize %></span>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">None</p>
    <% end %>

    <% triggers = @bot.config&.dig("triggers") || [] %>
    <% if triggers.any? %>
      <h3 class="text-sm font-medium text-gray-400 mb-2 mt-3">Triggers (<%= triggers.length %>)</h3>
      <% triggers.each do |trigger| %>
        <div class="text-xs text-gray-400 mb-1">
          <span class="text-gray-300"><%= trigger["name"] %></span>:
          When <span class="text-blue-300"><%= trigger.dig("condition", "type")&.humanize %></span>
          &rarr; <span class="text-green-300"><%= trigger.dig("action", "type")&.humanize %></span>
          <% unless trigger["enabled"] %><span class="text-red-400">(disabled)</span><% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Interactive Test Board with Swarm -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div>
    <h2 class="text-xl font-bold text-gray-200 mb-3">Test Board</h2>
    <div data-controller="bot-board" data-bot-board-config-value="<%= @bot.config.to_json %>">
      <div data-bot-board-target="board"></div>
      <div class="flex items-center justify-between mt-3">
        <span data-bot-board-target="status" class="text-sm text-gray-400"></span>
        <button type="button" data-action="click->bot-board#reset" class="text-sm text-gray-400 hover:text-white">Reset Board</button>
      </div>
      <div data-bot-board-target="notation" class="text-xs text-gray-500 mt-1 font-mono"></div>
    </div>
  </div>

  <div data-controller="swarm-display" data-swarm-display-config-value="<%= @bot.config.to_json %>"
       data-swarm-display-bot-board-outlet="[data-controller='bot-board']">
    <h2 class="text-xl font-bold text-gray-200 mb-3">Probability Swarm</h2>
    <p class="text-sm text-gray-400 mb-3">Run 50 simulations to see your bot's move tendencies as a heatmap.</p>
    <div class="relative">
      <canvas data-swarm-display-target="canvas" class="border border-gray-700 rounded"></canvas>
    </div>
    <button type="button" data-swarm-display-target="runButton" data-action="click->swarm-display#runSwarm"
            class="mt-3 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-4 py-2 rounded text-sm">
      Run Swarm (50x)
    </button>
    <div data-swarm-display-target="results" class="mt-3"></div>
  </div>
</div>
